{
  "dashboard": {
    "id": null,
    "uid": "fly-agent-overview",
    "title": "Fly Agent · 服务总览",
    "tags": ["fly-agent", "fastapi", "llm"],
    "timezone": "browser",
    "schemaVersion": 39,
    "version": 1,
    "refresh": "30s",
    "time": { "from": "now-6h", "to": "now" },
    "panels": [
      {
        "type": "timeseries",
        "title": "请求速率（按路径）",
        "datasource": { "type": "prometheus", "uid": "prometheus" },
        "targets": [
          {
            "expr": "sum by (endpoint) (rate(http_requests_total[5m]))",
            "legendFormat": "{{endpoint}}",
            "refId": "A"
          }
        ],
        "fieldConfig": { "defaults": { "unit": "reqps" }, "overrides": [] },
        "gridPos": { "x": 0, "y": 0, "w": 8, "h": 8 }
      },
      {
        "type": "stat",
        "title": "5xx 错误率",
        "datasource": { "type": "prometheus", "uid": "prometheus" },
        "targets": [
          {
            "expr": "sum(rate(http_requests_total{status=~\"5..\"}[5m])) / clamp_min(sum(rate(http_requests_total[5m])), 0.0001)",
            "legendFormat": "5xx",
            "refId": "A"
          }
        ],
        "fieldConfig": {
          "defaults": {
            "unit": "percentunit",
            "decimals": 2,
            "thresholds": {
              "mode": "absolute",
              "steps": [
                { "color": "green", "value": null },
                { "color": "yellow", "value": 0.01 },
                { "color": "red", "value": 0.05 }
              ]
            }
          },
          "overrides": []
        },
        "gridPos": { "x": 8, "y": 0, "w": 8, "h": 8 }
      },
      {
        "type": "stat",
        "title": "处理中请求",
        "datasource": { "type": "prometheus", "uid": "prometheus" },
        "targets": [
          {
            "expr": "sum(starlette_requests_in_progress)",
            "legendFormat": "in flight",
            "refId": "A"
          }
        ],
        "fieldConfig": { "defaults": { "unit": "short" }, "overrides": [] },
        "gridPos": { "x": 16, "y": 0, "w": 8, "h": 8 }
      },
      {
        "type": "timeseries",
        "title": "HTTP 延迟 P95（按路径）",
        "datasource": { "type": "prometheus", "uid": "prometheus" },
        "targets": [
          {
            "expr": "histogram_quantile(0.95, sum by (le, endpoint) (rate(http_request_duration_seconds_bucket[5m])))",
            "legendFormat": "{{endpoint}}",
            "refId": "A"
          }
        ],
        "fieldConfig": { "defaults": { "unit": "s" }, "overrides": [] },
        "gridPos": { "x": 0, "y": 8, "w": 12, "h": 8 }
      },
      {
        "type": "timeseries",
        "title": "LLM 延迟 P95（流式 / 非流式）",
        "datasource": { "type": "prometheus", "uid": "prometheus" },
        "targets": [
          {
            "expr": "histogram_quantile(0.95, sum by (le, model) (rate(llm_stream_duration_seconds_bucket[5m])))",
            "legendFormat": "{{model}} 流式",
            "refId": "A"
          },
          {
            "expr": "histogram_quantile(0.95, sum by (le, model) (rate(llm_inference_duration_seconds_bucket[5m])))",
            "legendFormat": "{{model}} 非流式",
            "refId": "B"
          }
        ],
        "fieldConfig": { "defaults": { "unit": "s" }, "overrides": [] },
        "gridPos": { "x": 12, "y": 8, "w": 12, "h": 8 }
      },
      {
        "type": "timeseries",
        "title": "会话标题生成（成功 / 失败）",
        "datasource": { "type": "prometheus", "uid": "prometheus" },
        "targets": [
          {
            "expr": "sum by (status) (rate(session_names_generated_total[5m]))",
            "legendFormat": "{{status}}",
            "refId": "A"
          }
        ],
        "fieldConfig": { "defaults": { "unit": "short" }, "overrides": [] },
        "gridPos": { "x": 0, "y": 16, "w": 24, "h": 8 }
      }
    ]
  },
  "overwrite": true
}
