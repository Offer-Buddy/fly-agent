# =============================================================================
# 环境变量配置模板
# =============================================================================
# 使用方法：
#   cp .env.example .env.development     # 再按需修改
#
# 解析规则（由 app/core/config.py 实现）：
#   1. 优先级：操作系统环境变量 > env 文件 > 按环境默认值 > 代码内默认值
#   2. 变量名大小写敏感，必须全大写
#   3. 列表类配置用英文逗号分隔，不用 JSON 数组
#   4. 等号右侧可以加引号；带空格的值建议加引号
#   5. 以 # 开头即注释，整行注释掉等于使用默认值
#
# 完整说明见 docs/configuration.md
# =============================================================================

# -----------------------------------------------------------------------------
# 应用基础
# -----------------------------------------------------------------------------
# 说明：VERSION、DESCRIPTION、API_V1_STR、JWT_ALGORITHM 已不再是环境变量。
#   VERSION / DESCRIPTION 直接读 pyproject.toml（单一来源，避免两处版本号打架）
#   API_V1_STR / JWT_ALGORITHM 属于代码契约，改了要同步改代码，不是"配置"
#   在这里写它们不会生效，会被静默忽略。

# 运行环境：development / staging / production / test
# 它同时决定加载哪个 .env.<env> 文件；写错会直接报错退出（不再静默降级）
APP_ENV=development

# 服务名，会显示在 API 文档标题与日志里
PROJECT_NAME="Web Assistant"

# 调试开关：true 时开启调试日志、性能剖析中间件与 /docs 的详细报错
DEBUG=true

# -----------------------------------------------------------------------------
# 跨域（CORS）
# -----------------------------------------------------------------------------
# 允许的前端来源，多个用英文逗号分隔；留空等价于放行全部（["*"]）
# 生产环境请写明具体域名，不要用 *
ALLOWED_ORIGINS="http://localhost:3000,http://localhost:8000"

# -----------------------------------------------------------------------------
# 可观测性：Langfuse 链路追踪
# -----------------------------------------------------------------------------
# 可观测性：Langfuse（外部独立部署，本仓库不负责起停）
# -----------------------------------------------------------------------------
# 是否启用追踪；false 时完全零开销，也不会创建 Langfuse 客户端。
# 把下面的地址与 key 填好之后改成 true。
LANGFUSE_TRACING_ENABLED=false

# Langfuse 项目的公钥 / 私钥：在你自己那套 Langfuse 的项目设置里复制 pk-/sk-
LANGFUSE_PUBLIC_KEY=""
LANGFUSE_SECRET_KEY=""

# Langfuse 服务地址。本项目只认这一处配置：
#   宿主机直跑（make dev）：  http://localhost:<你的端口>        —— 默认按 3010
#   容器内跑（make docker-up）：无需改，编排会覆盖成 host.docker.internal:<同一端口>
#   与 Langfuse 同网络：      设 LANGFUSE_HOST_INTERNAL=http://langfuse-web:3000
#   云端 Hobby：             https://cloud.langfuse.com
LANGFUSE_HOST=http://localhost:3010

# 配好 key 之后先跑一次 `make trace-smoke`：它会造一条探针 trace 并 flush，
# 确认「key 通、数据到、界面能看到」之后再接到业务里，否则排查起来会很盲目。

# -----------------------------------------------------------------------------
# 大模型（OpenAI 协议）
# -----------------------------------------------------------------------------
# 模型 API Key。走第三方兼容端点时，这里填那个端点签发的 key
OPENAI_API_KEY="your-llm-api-key"

# 可选：OpenAI 兼容端点地址。留空则用官方 OpenAI
# 例：DeepSeek  https://api.deepseek.com/v1
#     DashScope https://dashscope.aliyuncs.com/compatible-mode/v1
# 只要填了这一项，任何裸模型名都会被按 OpenAI 协议发往该地址
DEFAULT_LLM_MODEL=gpt-5.6-luna

# 采样温度：0 最稳定、1 最发散。用于对话一般 0.2~0.7
DEFAULT_LLM_TEMPERATURE=0.2

# 单次回复的最大 token 数
MAX_TOKENS=2000

# 每个模型的重试次数（仅对可重试错误：超时、5xx、限流）
MAX_LLM_CALL_RETRIES=3

# 整条 fallback 链的总超时预算（秒）。到点即放弃并返回兜底回复，
# 避免用户在一个会失败链路上干等两分钟
LLM_TOTAL_TIMEOUT=60

# 是否用首条消息自动生成会话标题（会额外产生一次小模型调用）
SESSION_NAMING_ENABLED=true

# 备用模型链，逗号分隔；主模型失败后按顺序环形重试
# 不写则只用一个模型
# LLM_FALLBACK_MODELS=deepseek-v4-pro

# ---- 备用方案：Atlas Cloud（OpenAI 兼容，一个 key 可用 50+ 模型）----
# 免费 key 申请：https://www.atlascloud.ai/console/coding-plan
# OPENAI_BASE_URL=https://api.atlascloud.ai/v1
# OPENAI_API_KEY=<your-atlascloud-key>
# DEFAULT_LLM_MODEL=deepseek-ai/deepseek-v4-pro

# -----------------------------------------------------------------------------
# 鉴权：JWT
# -----------------------------------------------------------------------------
# 签名密钥。生产环境必须换成 ≥32 位的随机串，
# 非 test 环境下长度不足或命中弱值黑名单会直接拒绝启动
# 生成方式：python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET_KEY="CHANGE_ME_TO_A_RANDOM_32_PLUS_CHAR_STRING"

# 签名算法固定为 HS256（写在 config.py 里），没有公钥加载逻辑，
# 改成 RS256 不会生效、只会让所有令牌失效，故不再暴露成环境变量。

# 访问令牌有效期（天）
JWT_ACCESS_TOKEN_EXPIRE_DAYS=30

# -----------------------------------------------------------------------------
# 数据库：PostgreSQL（需启用 pgvector 扩展，长期记忆依赖它）
# -----------------------------------------------------------------------------
# 主机名。Docker Compose 内用服务名 db；本地开发用 localhost
POSTGRES_HOST=db

# 库名 / 用户名 / 密码
POSTGRES_DB=mydb
POSTGRES_USER=myuser
POSTGRES_PASSWORD=mypassword

# 端口，宿主机默认 5432
POSTGRES_PORT=5432

# 连接池常驻连接数。并发高时可调大，注意不要超过数据库 max_connections
POSTGRES_POOL_SIZE=5

# 池满后允许临时超出的连接数，用满后请求开始排队
POSTGRES_MAX_OVERFLOW=10

# -----------------------------------------------------------------------------
# 缓存：Redis（可选）
# -----------------------------------------------------------------------------
# 留空 = 不启用 Redis，退回进程内 TTL 缓存（多实例不共享）
# Docker Compose 会在容器内覆盖为 REDIS_HOST=redis；本机 make dev 用 localhost
REDIS_HOST=

REDIS_PORT=6379

# 库号。默认 1，避免与共用实例上的其他服务撞键（例如 MaxKB 用 db 0）
REDIS_DB=1

# 密码，无密码留空
REDIS_PASSWORD=

# 连接池上限
REDIS_MAX_CONNECTIONS=20

# 记忆检索结果的缓存时长（秒）
CACHE_TTL_SECONDS=60

# -----------------------------------------------------------------------------
# 限流（slowapi 语法：次数 per 秒|分钟|小时|天）
# -----------------------------------------------------------------------------
# 全局兜底额度，可叠加多条，用逗号分隔
RATE_LIMIT_DEFAULT="1000 per day,200 per hour"

# 各接口单独额度（不写则用下面的代码默认值）
RATE_LIMIT_CHAT="100 per minute"
RATE_LIMIT_CHAT_STREAM="100 per minute"
RATE_LIMIT_MESSAGES="200 per minute"
RATE_LIMIT_LOGIN="100 per minute"
# RATE_LIMIT_REGISTER="10 per hour"
# RATE_LIMIT_ROOT="10 per minute"
# RATE_LIMIT_HEALTH="20 per minute"

# -----------------------------------------------------------------------------
# 性能剖析（仅 DEBUG=true 时生效）
# -----------------------------------------------------------------------------
# 剖析报告落盘目录
PROFILING_DIR=/tmp/fastapi_profiles

# 请求耗时超过该阈值（秒）才保存报告；设为 0 表示每个请求都剖析
PROFILING_THRESHOLD_SECONDS=2.0

# -----------------------------------------------------------------------------
# 日志
# -----------------------------------------------------------------------------
# 日志目录，启动时自动创建
LOG_DIR=logs

# 日志级别：DEBUG / INFO / WARNING / ERROR
# 不写时按环境取默认值：development=DEBUG，production=WARNING
LOG_LEVEL=DEBUG

# 输出格式：console（本地彩色可读）或 json（生产采集用）
LOG_FORMAT=console

# -----------------------------------------------------------------------------
# 长期记忆（mem0 + pgvector）
# -----------------------------------------------------------------------------
# 抽取记忆事实用的对话模型
# LONG_TERM_MEMORY_MODEL=gpt-5-nano

# 向量化模型。注意：不是所有供应商都提供 embeddings（例如 DeepSeek 没有）
# LONG_TERM_MEMORY_EMBEDDER_MODEL=text-embedding-3-small

# 向量模型可走独立端点与独立 key，留空则复用 OPENAI_BASE_URL / OPENAI_API_KEY
# LONG_TERM_MEMORY_EMBEDDER_BASE_URL=
# LONG_TERM_MEMORY_EMBEDDER_API_KEY=

# 向量维度，必须与所选向量模型的真实维度一致，否则写入 pgvector 会失败
# text-embedding-3-small=1536，text-embedding-v3(DashScope)=1024
# LONG_TERM_MEMORY_EMBEDDING_DIMS=1536

# pgvector 集合（表）名
# LONG_TERM_MEMORY_COLLECTION_NAME=longterm_memory

# -----------------------------------------------------------------------------
# LLM 评测（make eval）
# -----------------------------------------------------------------------------
# 打分用的模型，建议用能力较强的模型，避免评测本身成为噪声来源
# EVALUATION_LLM=gpt-5

# 评测模型的端点
# EVALUATION_BASE_URL=https://api.openai.com/v1

# 评测专用 key，留空则复用 OPENAI_API_KEY
# EVALUATION_API_KEY=

# 每条 trace 之间的间隔（秒），避免把评测模型打到限流
# EVALUATION_SLEEP_TIME=10
