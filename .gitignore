# Python-generated files
__pycache__/
*.py[oc]
build/
dist/
wheels/
*.egg-info
*.jsonl

# Virtual environments（.venv 之外的实验环境也一并忽略，例如 .venv-poc）
.venv*/
venv/

# Environment variables
.env
.env.development
.env.staging
.env.production
.env.*.local

# IDE / 编辑器（项目配置走 .vscode/，各人的 IDE 索引不入库）
.idea/
*.iml
*.swp

# 运行时产物
logs/
.ruff_cache/
.pytest_cache/
.profiling/
htmlcov/
.coverage

# 工作台本地数据
.workbuddy/

# 内容稿的中间版本（课程 HTML 反复改版会留下 .bak）
*.bak.html

# docs 目录整体脱管：文档与课程稿只在本地维护，不进版本库
# 注意：本规则只对未跟踪文件生效；已入库的文件需 git rm --cached 才会真正退出跟踪
docs/

# archify 绘图技能的原子发布临时产物（交付锁 / 暂存 / 溯源 / 对比 / 交付中间态）
# 正常流程自行清理，异常中断时会残留 .archify-* 或 .archify-xxx/ 目录
.archify
.archify-*
*.finalize-summary.json

# Misc
*.ipynb

# Reports
evals/reports/

# 本地模型（bge-small-zh + bge-reranker-base，合计约 1.2GB，不入库）
# 注意开头的斜杠：只忽略仓库根目录的 models/，否则 app/models/ 会被一起吞掉
/models/

# 检索评测结果（每次运行都生成，只留本地）
data/eval/result_*.json

# Playwright MCP 抓取的调试快照（页面截图 / DOM dump）
.playwright-mcp/
