# Python-generated files
__pycache__/
*.py[oc]
build/
dist/
wheels/
*.egg-info
*.jsonl

# Virtual environments（.venv 之外的实验环境也一并忽略，例如 .venv-poc）
.venv*/
venv/

# Environment variables
.env
.env.development
.env.staging
.env.production
.env.*.local

# IDE / 编辑器（项目配置走 .vscode/，各人的 IDE 索引不入库）
.idea/
*.iml
*.swp

# 运行时产物
logs/
.ruff_cache/
.pytest_cache/
.profiling/
htmlcov/
.coverage

# 工作台本地数据
.workbuddy/

# 内容稿的中间版本（课程 HTML 反复改版会留下 .bak）
*.bak.html

# docs 目录整体脱管：文档与课程稿只在本地维护，不进版本库
# 注意：本规则只对未跟踪文件生效；已入库的文件需 git rm --cached 才会真正退出跟踪
docs/

# Misc
*.ipynb

# Reports
evals/reports/
